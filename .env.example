# Frontend Next.js server URL (browser calls this)
# This should point to the Next.js server, NOT the backend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Backend Hono server URL (Next.js API routes call this)
# This is used by server-side API routes to forward requests
BACKEND_BASE_URL="http://localhost:3000"

# Backend URL for client-side redirects (Google OAuth, etc.)
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# For production (Vercel frontend + Render backend)
# NEXT_PUBLIC_API_URL="https://your-frontend.vercel.app"
# BACKEND_BASE_URL="https://smarthome-backend.onrender.com"
# NEXT_PUBLIC_BACKEND_URL="https://smarthome-backend.onrender.com"
