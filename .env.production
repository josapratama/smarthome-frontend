# Production Environment Variables
# These will be used when building for production

# Backend URL (server-side)
BACKEND_URL=http://host.docker.internal:3000

# Backend URL (client-side - accessible from browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Frontend URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# App Name
NEXT_PUBLIC_APP_NAME=Smart Home

# Node Environment
NODE_ENV=production
